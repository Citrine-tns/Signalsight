# Unity .gitattributes
# Source: https://github.com/github/gitattributes/blob/main/Unity.gitattributes
#
# Mac/Win 混在開発で行末コード混入による diff 汚染を防ぐためのルール。
# - 通常テキスト（.cs / .shader / .md など）はリポジトリ内で LF 固定。
# - Unity YAML 系（.unity / .prefab / .asset / .meta など）は Unity が常に LF で
#   書き出すため `-text` を立てて git の自動変換を無効化（破損防止）。
# - バイナリ（画像・音声・3D モデル等）は `binary` でテキスト処理を完全に止める。

# Macro for Unity YAML-based asset files.
[attr]unityyaml -text merge=unityyamlmerge diff

# Macro for all binary files that should use Git LFS.
[attr]lfs -text filter=lfs diff=lfs merge=lfs

# Default to LF for text files.
* text=auto eol=lf

# Unity assets
*.anim          unityyaml
*.asset         unityyaml
*.controller    unityyaml
*.mat           unityyaml
*.meta          unityyaml
*.prefab        unityyaml
*.unity         unityyaml

